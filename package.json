{
  "name": "joking-ai",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:models": "node scripts/build-teapot-model.mjs --check && node scripts/verify-model-assets.mjs",
    "test:inference": "node scripts/smoke-inference.mjs",
    "test:inference:pelican": "node scripts/smoke-inference.mjs --pelican-only",
    "test:inference:upstream": "node scripts/smoke-inference.mjs --upstream-only",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "vitest": "4.1.12"
  }
}
